---
import { getCollection } from 'astro:content';
import * as aboutMe from '../contents/aboutme.md';
import '../styles/new.css' 
import { render } from 'astro:content';
import { Image, Picture } from 'astro:assets';

var games = await getCollection("games");
games = games.sort((a, b) => b.data.order - a.data.order);
var webs = await getCollection("webs");
var personals = await getCollection("personals");
webs = webs.sort((a, b) => b.data.order - a.data.order);
personals = personals.sort((a, b) => b.data.order - a.data.order);

function expand() {
  alert("expand");
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-zinc-950 text-white font-base">
    <main class="min-w-[400px] w-3/5 lg:w-5/6 lg:max-w-[1080px] m-auto sticky">
      <nav class="text-xl w-[100%] flex flex-row-reverse p-[40px]">
        <a href="#" class="px-[10px] hover:text-cyan-400">
          Contact
          <div class="rounded-[4px] w-[1px] m-auto"></div>
        </a>
        <a href="#" class="px-[10px] hover:text-cyan-400">
          Skills
          <div class="rounded-[4px] w-[1px] m-auto"></div>
        </a>
        <a href="#" class="px-[10px] hover:text-cyan-400">
          Portfolio
          <div class="rounded-[4px] w-[1px] m-auto current"></div>
        </a>
      </nav>
      <section class="min-w-[300px] p-[48px]">
        <header class="text-5xl font-title py-[20px] font-medium uppercase">
          {aboutMe.frontmatter.introduction}
        </header>
        <article class="text-2xl text-zinc-300 font-light">
          <aboutMe.Content />
        </article>
      </section>
      <section class="">
        <header class="text-3xl px-[20px] flex py-[10px] backdrop-blur sticky top-0 bg-zinc-950/75">
          <span>Professional Game Projects</span>
          <hr class="inline flex-grow my-[20px] mx-[20px] border-zinc-400" />
        </header>
        <article class="grid grid-cols-1 lg:grid-cols-2">
          {games.map(async(game) => {
            const { Content } = await render(game)
            return (
            <div class="entry p-[30px] hover:bg-zinc-900 mx-[20px]">
              <header class="entrytitle text-xl pb-[12px]">
                <span>{game.data.gametitle}</span>
                <span class="text-base"> {'('}{game.data.order}{')'}</span>
              </header>
              <figure class="h-[200px] items-center flex gap-[4px] bg-gray-900">
                {game.data.images.map(image =>
                  <button class="gallery grow-1">
                    <Picture
                      src={image}
                      formats={['webp']}
                      alt={game.data.title}
                      class="w-[100%] max-h-[200px] object-cover" />
                  </button>
                )}
              </figure>
              <div class="text-sm py-[20px] text-zinc-300 font-light">
                <Content />
              </div>
              <footer class="pt-[24px] text-sm">
                {Object.entries(game.data.links).map(entry =>
                  <a target="_blank" class="entrylinks inline-block hover:bg-cyan-900! hover:text-cyan-400 m-[5px] p-[15px] bg-gray-900" href={entry[1]}>{entry[0]}</a>
                )}
              </footer>
            </div>
            )}
          )}
        </article>
      </section>
      <section class="pt-[48px]">
        <header class="text-3xl px-[20px] flex py-[10px] backdrop-blur sticky top-0 bg-zinc-950/75">
          <span>Web Development</span>
          <hr class="inline flex-grow my-[20px] mx-[20px] border-zinc-400" />
        </header>
        <article class="grid grid-cols-1 lg:grid-cols-2">
          {webs.map(async(web) => {
            const { Content } = await render(web);
            return (
              <div class="entry p-[30px] hover:bg-zinc-900 mx-[20px]">
                <header class="entrytitle text-xl pb-[12px]">
                  <span>{web.data.title}</span>
                  <span class="text-base"> {'('}{web.data.order}{')'}</span>
                </header>
                <div class="text-sm py-[10px]">
                  {web.data.keywords.map(keyword =>
                    <span class="bg-zinc-800 text-zinc-400 p-[8px] rounded-[5px] mx-[4px]">{keyword}</span>
                  )}
                </div>
              <div class="text-sm py-[20px] text-zinc-300 font-light">
                <Content />
              </div>
              </div>
            )}
          )}
        </article>
      </section>
      <section class="pt-[48px]">
        <header class="text-3xl px-[20px] flex py-[10px] backdrop-blur sticky top-0 bg-zinc-950/75">
          <span>Personal Projects</span>
          <hr class="inline flex-grow my-[20px] mx-[20px] border-zinc-400" />
        </header>
        <article class="grid grid-cols-1 lg:grid-cols-2">
          {personals.map(async(personal) => {
            const { Content } = await render(personal);
            return (
              <div class="entry p-[30px] hover:bg-zinc-900 mx-[20px]">
                <header class="entrytitle text-xl pb-[12px]">
                  <span>{personal.data.gametitle}</span>
                  <span class="text-base"> {'('}{personal.data.order}{')'}</span>
                </header>
                <figure class="h-[160px] items-center flex gap-[4px] bg-gray-900">
                  {personal.data.images.map(image =>
                    <button class="gallery grow-1">
                      <Image
                        src={image}
                        alt={personal.data.title}
                        class="w-[100%] max-h-[160px] object-cover" />
                    </button>
                  )}
                </figure>
                <div class="text-sm py-[20px] text-zinc-300 font-light">
                  <Content />
                </div>
                <footer class="pt-[24px] text-sm">
                  {Object.entries(personal.data.links).map(entry =>
                    <a target="_blank" class="entrylinks inline-block hover:bg-cyan-900! hover:text-cyan-400 m-[5px] p-[15px] bg-gray-900" href={entry[1]}>{entry[0]}</a>
                  )}
                </footer>
              </div>
            )}
          )}
        </article>
      </section>
      <section class="px-[20px] py-[60px] text-zinc-300">
        Designed with Figma. Custom-built with Astro and Tailwind. <a target="_blank" class="hover:underline" href="https://github.com/tastelikecoke/portfolio-astro">Source here.</a>
      </section>
    </main>
  </body>
  <script>
    const galleries = document.querySelectorAll("button.gallery");
    galleries.forEach((button) => {
      button.addEventListener("click", () => {
        if (button.className === "gallery grow-1")
          button.className = "gallery-clicked grow-1";
        else
          button.className = "gallery grow-1";
      });
    });
  </script>
</html>
