---
import { Content  as AboutMe } from '../contents/aboutme.md';
import '../styles/global.css';
import 'purecss/build/pure-min.css';

const menu = [
	["portfolio", "Portfolio", [
			["aboutme", "About Me"],
		]
	],
	["games", "Games", [
			["aboutme", "About Me"],
			["professional", "Professional"],
		]
	],
]
var games = Object.values(import.meta.glob('../contents/games/*.md', { eager: true }));
var personalgames = Object.values(import.meta.glob('../contents/personalgames/*.md', { eager: true }));

games = games.sort((a, b) => b.frontmatter.order - a.frontmatter.order);
personalgames = personalgames.sort((a, b) => b.frontmatter.order - a.frontmatter.order);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="generator" content={Astro.generator} />
    	<link href='https://fonts.googleapis.com/css?family=Overpass' rel='stylesheet'>
		<title>Astro</title>
	</head>
	<body>
		<div id="layout">
			<!-- Menu toggle -->
			<a href="#menu" id="menuLink" class="menu-link">
				<!-- Hamburger icon -->
				<span></span>
			</a>
			<div id="menu">
				<div class="pure-menu">
				{menu.map(item =>
						<a class="pure-menu-heading" href={"#"+item[0]}>{item[1]}</a>
						<ul class="pure-menu-list">
							{item[2].map(subitem =>
								<li class="pure-item">
									<a class="pure-menu-link" href={"#"+subitem[0]}>{subitem[1]}</a>
								</li>
							)
							}
						</ul>
				)}
				</div>
			</div>
			<div id="main">
				<div class="header">
					<h1>Jeru Mercado</h1>
				</div>
				<div class="content">
					<a name="aboutme"></a>
					<h1>About Me</h1>
					<AboutMe />
				</div>
					
				<div class="content">
					<a name="professional"></a>
					<h1>Game Projects</h1>
					{games.map(game =>
						<h2>{game.frontmatter.title}</h2>
						<Fragment set:html={game.compiledContent()}/>
					)}
					<h1>Personal Game Projects</h1>
					{personalgames.map(game =>
						<h2>{game.frontmatter.title}</h2>
						<Fragment set:html={game.compiledContent()}/>
					)}
				</div>
			</div>
		</div>
	</body>

	<script is:inline>
		(function (window, document) {
			// we fetch the elements each time because docusaurus removes the previous
			// element references on page navigation
			function getElements() {
				return {
					layout: document.getElementById('layout'),
					menu: document.getElementById('menu'),
					menuLink: document.getElementById('menuLink')
				};
			}

			function toggleClass(element, className) {
				var classes = element.className.split(/\s+/);
				var length = classes.length;
				var i = 0;

				for (; i < length; i++) {
					if (classes[i] === className) {
						classes.splice(i, 1);
						break;
					}
				}
				// The className is not found
				if (length === classes.length) {
					classes.push(className);
				}

				element.className = classes.join(' ');
			}

			function toggleAll() {
				var active = 'active';
				var elements = getElements();

				toggleClass(elements.layout, active);
				toggleClass(elements.menu, active);
				toggleClass(elements.menuLink, active);
			}
			
			function handleEvent(e) {
				var elements = getElements();
				
				if (e.target.id === elements.menuLink.id) {
					toggleAll();
					e.preventDefault();
				} else if (elements.menu.className.indexOf('active') !== -1) {
					toggleAll();
				}
			}
			
			document.addEventListener('click', handleEvent);

		}(this, this?.document));
	</script>

</html>
