---
import * as aboutMe from '../contents/aboutme.md';
import '../styles/new.css' 

var games = Object.values(import.meta.glob('../contents/games/*.md', { eager: true }));
games = games.sort((a, b) => b.frontmatter.order - a.frontmatter.order);

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
      <link href='https://fonts.googleapis.com/css?family=Overpass' rel='stylesheet'></link>
    <title>Astro</title>
  </head>
  <body class="bg-black text-white font-base">
    <section class="aboutme center">
      <header class="text-6xl font-title">{aboutMe.frontmatter.introduction}</header>
      <article class="">
        <aboutMe.Content />
      </article>
    </section>
    <section class="games">
      <header>Professional Game Projects</header>
      <section>
        <div>
					{games.map(game =>
            <header>{game.frontmatter.title}</header>
            <article>
              <game.Content />
            </article>
          )}
        </div>
      </section>
    </section>
    <section class="web">
      <header>Web Development</header>
      <section>
        <div>
					{games.map(game =>
            <header>{game.frontmatter.title}</header>
            <article>
              <game.Content />
            </article>
          )}
        </div>
      </section>
    </section>
  </body>
</html>
